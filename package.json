{
  "name": "morly-kong-racing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:server && node scripts/precache.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs",
    "start": "node build/server.mjs",
    "test": "vitest run",
    "test:online": "tsx tests/online.ts",
    "assets": "tsx scripts/export-assets.ts",
    "budget": "node scripts/budget.mjs",
    "test:reconnect": "tsx tests/reconnect.ts",
    "test:online-race": "tsx tests/online-race.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "@babylonjs/loaders": "9.29.0",
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babylonjs/serializers": "9.29.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
